{
  "compilerOptions": {
    "lib": [
      "es2020"
    ],
    "types": [
      "node"
    ],
    "target": "ES2019",
    "noImplicitAny": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}